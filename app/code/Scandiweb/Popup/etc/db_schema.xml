<?xml version="1.0"?>

<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="scandiweb_popup" resource="default" engine="innodb" comment="Popup Block Table">
        <column xsi:type="smallint" name="popup_id" unsigned="false" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="varchar" name="popup_name" nullable="false" length="255" comment="Popup Name"/>
        <column xsi:type="mediumtext" name="popup_content" nullable="true" comment="Popup Content"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Block Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Block Modification Time"/>
        <column xsi:type="smallint" name="is_active" unsigned="false" nullable="false" identity="false"
                default="1" comment="Is Block Active"/>
        <column xsi:type="smallint" name="timeout" unsigned="false" nullable="false" identity="false"
                default="1" comment="Popup Timeout"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="popup_id"/>
        </constraint>
        <index referenceId="SCANDIWEB_POPUP_NAME_CONTENT" indexType="fulltext">
            <column name="popup_name"/>
            <column name="popup_content"/>
        </index>
    </table>
</schema>
