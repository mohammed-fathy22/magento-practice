<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
        
    <!-- Repository preference -->
    <preference for="Scandiweb\Popup\Api\PopupRepositoryInterface"
                type="Scandiweb\Popup\Service\PopupRepository"/>

    <!-- Inject missing PopupCollectionFactory -->
    <type name="Scandiweb\Popup\Service\PopupRepository">
        <arguments>
            <argument name="popupCollectionFactory" xsi:type="object">
                Scandiweb\Popup\Model\ResourceModel\Popup\CollectionFactory
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="scandiweb_popup_listing_data_source" xsi:type="string">
                    Scandiweb\Popup\Model\ResourceModel\Popup\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Scandiweb\Popup\Model\ResourceModel\Popup\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">scandiweb_popup</argument>
            <argument name="eventPrefix" xsi:type="string">scandiweb_popup_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">popup_grid_collection</argument>
            <argument name="resourceModel" xsi:type="string">Scandiweb\Popup\Model\ResourceModel\Popup</argument>
            <argument name="model" xsi:type="string">Scandiweb\Popup\Model\Popup</argument>
        </arguments>
    </type>
</config>